#!/usr/bin/env sh
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

if echo "$STAGED" | grep -q '^core-service/'; then
  cd "$REPO_ROOT/core-service"

  echo "[pre-commit] core-service: typecheck (strict)"
  npm run --silent typecheck

  echo "[pre-commit] core-service: lint"
  npm run --silent lint

  echo "[pre-commit] core-service: security scan (npm audit — informational, does not block)"
  npm audit --audit-level=high || echo "[pre-commit] npm audit found issues above — not blocking the commit; fix on your own schedule"

  echo "[pre-commit] core-service: sanity checks (unit tests + architecture boundaries)"
  npm run --silent test:unit
  npm run --silent boundaries

  cd "$REPO_ROOT"
fi

if echo "$STAGED" | grep -q '^frontend/'; then
  cd "$REPO_ROOT/frontend"

  echo "[pre-commit] frontend: typecheck"
  npm run --silent typecheck

  echo "[pre-commit] frontend: lint"
  npm run --silent lint

  cd "$REPO_ROOT"
fi

echo "[pre-commit] all checks passed"
