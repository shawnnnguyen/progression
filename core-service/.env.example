DATABASE_URL="postgresql://core:core@localhost:5433/core_service?schema=public"

TEST_DATABASE_URL="postgresql://core:core@localhost:5433/core_service_test?schema=public"

PORT=3000
HOST=0.0.0.0

WEB_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET="dev-only-change-me-access"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

REPLICA_COUNT=1

# Optional — invite emails via Resend (https://resend.com). When either is
# unset, invite emails are logged to the console instead of sent, so local
# dev works with no setup. RESEND_FROM_EMAIL must be a verified sender/domain
# in the Resend account (done in the Resend dashboard, not here).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
