# Postgres connection used by Prisma (see docker-compose.yml for local values).
# Published on 5433, not 5432, to avoid colliding with any native/other local
# Postgres install already bound to the default port.
DATABASE_URL="postgresql://core:core@localhost:5433/core_service?schema=public"

# Separate DB used only by integration tests (test/integration/**), kept apart
# from the dev DB so a bad test run never truncates dev data.
TEST_DATABASE_URL="postgresql://core:core@localhost:5433/core_service_test?schema=public"

PORT=3000
HOST=0.0.0.0

# Human-user access-token signing key. Kept intentionally distinct from any
# future service act-as token signing key (see BACKEND_PLAN.md §5) so a token
# minted for one audience can never be replayed against the other. Refresh
# tokens are opaque random bytes stored hashed (§5), not JWTs, so there is no
# separate refresh-token signing secret.
JWT_ACCESS_SECRET="dev-only-change-me-access"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Real-time layer is single-instance only in v1 (BACKEND_PLAN.md §2) — the
# process refuses to boot if it detects a replica ordinal/count above 1.
REPLICA_COUNT=1
