# Base URL of core-service. Must be in core-service's WEB_ORIGIN allow-list.
VITE_API_URL=http://localhost:3000

# Dev-only auto-login (see features/auth/lib/devAutoLogin.ts) — stands in for
# a real login screen while one doesn't exist yet. Only read inside an
# `import.meta.env.DEV` branch, never exposed on the shared `env` object, so
# these never survive into a production build. Matches the seeded owner
# account in core-service/prisma/seed.ts; leave unset in any non-dev build.
VITE_DEV_LOGIN_EMAIL=owner@example.com
VITE_DEV_LOGIN_PASSWORD=password123!
